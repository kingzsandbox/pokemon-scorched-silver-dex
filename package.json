{
  "name": "scorched-silver-dex-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "import:core": "tsc -p scripts/tsconfig.json && node .import-build/scripts/import-core.js",
    "import:pokemon": "tsc -p scripts/tsconfig.json && node .import-build/scripts/import-pokemon.js"
  },
  "dependencies": {
    "next": "15.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.5",
    "typescript": "5.8.3"
  }
}
